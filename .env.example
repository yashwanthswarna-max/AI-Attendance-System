# Server Configuration
SECRET_KEY=super-secret-attendance-key-2026
JWT_SECRET_KEY=jwt-secret-attendance-token-key-2026
FLASK_ENV=development
PORT=5000

# Database Configuration (SQLite default; can use mysql+pymysql://user:pass@localhost/attendance_db)
DATABASE_URI=sqlite:///attendance.db

# Biometric & Recognition Configuration
FACE_MATCH_THRESHOLD=0.55
LIVENESS_DETECTION_ENABLED=True
ANTI_SPOOF_TEXTURE_THRESHOLD=35.0
ALLOW_DUPLICATE_PER_DAY=False
